{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": {
        "$value": "#f8f8f6",
        "$description": "Warm architectural canvas used behind page sections."
      },
      "foreground": { "$value": "#141414" },
      "border": { "$value": "#e0e0e0" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#141414" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#141414" },
      "primary": {
        "$value": "#6f962c",
        "$description": "BeeZ lime-green brand color. Use for calls to action, active states, and selected emphasis."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#f0f0f0" },
      "secondaryForeground": { "$value": "#141414" },
      "muted": { "$value": "#f0f0f0" },
      "mutedForeground": { "$value": "#6b6b6b" },
      "accent": { "$value": "#6f962c" },
      "accentForeground": { "$value": "#ffffff" },
      "destructive": { "$value": "#ef4444" },
      "destructiveForeground": { "$value": "#fafafa" },
      "input": { "$value": "#e0e0e0" },
      "ring": { "$value": "#6f962c" },
      "chart1": { "$value": "#6f962c" },
      "chart2": { "$value": "#141414" },
      "chart3": { "$value": "#4d91b3" },
      "chart4": { "$value": "#70c299" },
      "chart5": { "$value": "#b34d4d" },
      "sidebar": { "$value": "#fafafa" },
      "sidebarForeground": { "$value": "#404040" },
      "sidebarBorder": { "$value": "#e5e5e5" },
      "sidebarPrimary": { "$value": "#6f962c" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#f0f0f0" },
      "sidebarAccentForeground": { "$value": "#141414" },
      "sidebarRing": { "$value": "#6f962c" }
    },
    "dark": {
      "background": { "$value": "#0f0f0f" },
      "foreground": { "$value": "#f1efea" },
      "border": { "$value": "#292929" },
      "card": { "$value": "#1a1a1a" },
      "cardForeground": { "$value": "#f1efea" },
      "popover": { "$value": "#1a1a1a" },
      "popoverForeground": { "$value": "#f1efea" },
      "primary": { "$value": "#8ec431" },
      "primaryForeground": { "$value": "#0f0f0f" },
      "secondary": { "$value": "#242424" },
      "secondaryForeground": { "$value": "#f1efea" },
      "muted": { "$value": "#242424" },
      "mutedForeground": { "$value": "#8c8c8c" },
      "accent": { "$value": "#8ec431" },
      "accentForeground": { "$value": "#0f0f0f" },
      "destructive": { "$value": "#7f1d1d" },
      "destructiveForeground": { "$value": "#f1efea" },
      "input": { "$value": "#383838" },
      "ring": { "$value": "#8ec431" },
      "chart1": { "$value": "#8ec431" },
      "chart2": { "$value": "#f1efea" },
      "chart3": { "$value": "#f08c3c" },
      "chart4": { "$value": "#a855d6" },
      "chart5": { "$value": "#e0497a" },
      "sidebar": { "$value": "#141414" },
      "sidebarForeground": { "$value": "#f5f5f5" },
      "sidebarBorder": { "$value": "#262626" },
      "sidebarPrimary": { "$value": "#8ec431" },
      "sidebarPrimaryForeground": { "$value": "#0f0f0f" },
      "sidebarAccent": { "$value": "#242424" },
      "sidebarAccentForeground": { "$value": "#f1efea" },
      "sidebarRing": { "$value": "#8ec431" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": {
        "$value": ["Playfair Display", "Georgia", "serif"],
        "$description": "Editorial display face used for architectural headlines and emphasis."
      },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
